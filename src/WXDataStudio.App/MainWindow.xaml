<Window x:Class="WXDataStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WXDataStudio · 微信记录恢复" Height="880" Width="1500" MinHeight="700" MinWidth="1120"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="ChatBubbleStyle" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E4E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="4,3,4,3"/>
            <Setter Property="MaxWidth" Value="560"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOutgoing}" Value="True">
                    <Setter Property="HorizontalAlignment" Value="Right"/>
                    <Setter Property="Background" Value="#95EC69"/>
                    <Setter Property="BorderBrush" Value="#86D95E"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Background" Value="#07C160"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="PlainButton" TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <!-- 微信式的转账/红包卡片 -->
        <Style x:Key="TransactionCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="Background" Value="#F5A623"/>
            <Setter Property="MinWidth" Value="210"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRedPacket}" Value="True">
                    <Setter Property="Background" Value="#FA5151"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPayment}" Value="True">
                    <Setter Property="Background" Value="#07C160"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="'Microsoft YaHei UI','Segoe UI',sans-serif"/>
        </Style>
    </Window.Resources>

    <DockPanel Background="#F5F6F7">
        <!-- 顶部：只有三个主要动作 -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E4E6EA" BorderThickness="0,0,0,1" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="WXDataStudio" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="BuildStampText" FontSize="11" Foreground="#98A0A8"
                               VerticalAlignment="Bottom" Margin="8,0,0,2"/>
                    <Border Background="#F0F2F5" CornerRadius="12" Padding="10,4" Margin="14,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DeviceIndicator" Width="8" Height="8" Fill="#B0B7BF"
                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="DeviceBadge" Text="手机未连接" FontSize="12" VerticalAlignment="Center"
                                       Foreground="#5A6472"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="SnapshotBadge" Text="" FontSize="12" Foreground="#8C959F"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="读取微信记录" Style="{StaticResource PrimaryButton}" Click="OnLoadFromPhone"
                            ToolTip="连接手机，自动备份并把聊天记录读到电脑上（一步完成）"/>
                    <Button Content="写回手机" Style="{StaticResource PlainButton}" Margin="10,0,0,0"
                            x:Name="HeaderWriteBackButton" Click="OnWriteBackToPhone"
                            ToolTip="把工作副本里的修改同步回手机微信"/>
                    <Button Content="使用教程" Style="{StaticResource PlainButton}" Margin="10,0,0,0" Click="OnShowGuide"
                            ToolTip="一看就会的分步操作说明"/>
                    <Menu Background="Transparent" VerticalAlignment="Center" Margin="6,0,0,0">
                        <MenuItem Header="更多" Padding="12,7" ToolTip="备份、导出、检查等进阶功能">
                            <MenuItem Header="选择电脑上的备份" Click="OnSelectSnapshot"/>
                            <MenuItem Header="重新读取当前备份" Click="OnAnalyzeSnapshot"/>
                            <MenuItem Header="导出这段聊天（HTML/JSON）" Click="OnExportConversation"/>
                            <Separator/>
                            <MenuItem Header="生成回滚包" Click="OnCreateRollbackPackage"/>
                            <MenuItem Header="检查备份完整性" Click="OnRunIntegrityCheck"/>
                            <MenuItem Header="手机体检" Click="OnRefreshDevice"/>
                            <MenuItem Header="查看数据库信息" Click="OnDatabaseDiagnostics"/>
                            <MenuItem Header="手动输入数据库密钥" Click="OnDatabaseKey"/>
                            <MenuItem Header="恢复密钥诊断" Click="OnKeyDiagnostics"/>
                            <MenuItem Header="迁移准备检查" Click="OnMigrationCheck"/>
                            <Separator/>
                            <MenuItem Header="运行只读自检（阶段三）" Click="OnStage3Acceptance"/>
                        </MenuItem>
                    </Menu>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 下一步提示 -->
        <Border DockPanel.Dock="Top" Background="#EAF4FF" BorderBrush="#CFE4FF" BorderThickness="0,0,0,1" Padding="18,8">
            <TextBlock x:Name="GuideHint" Foreground="#1B5FA8" FontSize="13" TextTrimming="CharacterEllipsis"
                       Text="第 1 步：点右上角【读取微信记录】，手机连上就能把聊天记录读到电脑上。"/>
        </Border>

        <!-- 底部：一行状态 + 可展开的日志 -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#E4E6EA" BorderThickness="0,1,0,0" Padding="18,8">
            <StackPanel>
                <Grid>
                    <TextBlock x:Name="StatusText" Text="准备就绪" Foreground="#3C4652" FontSize="13"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <ToggleButton x:Name="LogToggle" Content="详细日志" HorizontalAlignment="Right" Padding="10,3"
                                  FontSize="12" Click="OnToggleLog" ToolTip="遇到问题时展开查看每一步的细节"/>
                </Grid>
                <Expander x:Name="LogExpander" Header="" IsExpanded="False" Visibility="Collapsed" Margin="0,6,0,0">
                    <ListBox x:Name="LogList" FontFamily="Consolas" FontSize="11" Height="120"
                             BorderThickness="0" Background="#FAFBFC"/>
                </Expander>
            </StackPanel>
        </Border>

        <Grid Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition x:Name="DetailColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- 左：会话 -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" BorderBrush="#E4E6EA" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="聊天" FontSize="16" FontWeight="SemiBold" Margin="14,12,14,8"/>
                    <TextBox DockPanel.Dock="Top" x:Name="SearchBox" Height="32" Margin="12,0,12,10"
                             ToolTip="输入名字或关键词找人、找群" TextChanged="OnSearchChanged"/>
                    <ListBox x:Name="ConversationList" SelectionChanged="OnConversationSelected" BorderThickness="0"/>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- 中：聊天内容 -->
            <Border Grid.Column="2" Background="White" CornerRadius="8" BorderBrush="#E4E6EA" BorderThickness="1">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="14,12,14,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="ConversationTitle" Text="还没有读取记录" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="看到的和微信里一样；想改哪条，点它一下" FontSize="12" Foreground="#8C959F" Margin="0,3,0,0"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" Width="130" SelectedIndex="0" x:Name="MessageFilter"
                                  VerticalAlignment="Top" SelectionChanged="OnMessageFilterChanged"
                                  ToolTip="只看某一类消息">
                            <ComboBoxItem Content="全部消息"/><ComboBoxItem Content="只有文字"/>
                            <ComboBoxItem Content="图片视频语音"/><ComboBoxItem Content="链接/卡片"/>
                            <ComboBoxItem Content="系统提示"/><ComboBoxItem Content="红包转账"/>
                        </ComboBox>
                        <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0">
                            <Menu Background="Transparent" DockPanel.Dock="Left">
                                <MenuItem Header="＋ 添加消息" Padding="12,6" ToolTip="在电脑上的副本里补一条记录">
                                    <MenuItem x:Name="AddTextButton" Header="文字" Click="OnAddText"/>
                                    <MenuItem x:Name="AddImageButton" Header="图片" Click="OnAddImage"/>
                                    <MenuItem x:Name="AddVideoButton" Header="视频" Click="OnAddVideo"/>
                                    <MenuItem x:Name="AddVoiceButton" Header="语音" Click="OnAddVoice"/>
                                    <MenuItem x:Name="AddFileButton" Header="文件" Click="OnAddFile"/>
                                    <MenuItem x:Name="AddEmojiButton" Header="表情" Click="OnAddEmoji"/>
                                    <MenuItem x:Name="AddCardButton" Header="位置" Click="OnAddCard"/>
                                    <MenuItem x:Name="AddContactButton" Header="名片" Click="OnAddContact"/>
                                    <MenuItem x:Name="AddLinkButton" Header="链接 / 小程序" Click="OnAddLink"/>
                                    <MenuItem x:Name="AddQuoteButton" Header="引用消息" Click="OnAddQuote"/>
                                </MenuItem>
                            </Menu>
                            <TextBox x:Name="MessageSearchBox" Height="30" Margin="10,0,0,0"
                                     ToolTip="在这段聊天里搜内容" TextChanged="OnMessageSearchChanged"/>
                        </DockPanel>
                    </Grid>

                    <!-- 和微信一样的输入栏：打字 → 发送 -->
                    <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#E4E6EA" BorderThickness="0,1,0,0" Padding="10,8">
                        <StackPanel>
                            <WrapPanel Margin="0,0,0,6">
                                <Button Content="😊 表情" Padding="10,5" Margin="0,0,6,0" Click="OnToggleEmoji"
                                        ToolTip="选一个表情插入到输入框"/>
                                <Button Content="🖼 图片" Padding="10,5" Margin="0,0,6,0" Click="OnAddImage"/>
                                <Button Content="💸 转账" Padding="10,5" Margin="0,0,6,0" Tag="transfer" Click="OnAddMoneyMessage"/>
                                <Button Content="🧧 红包" Padding="10,5" Margin="0,0,6,0" Tag="redpacket" Click="OnAddMoneyMessage"/>
                                <Menu Background="Transparent" VerticalAlignment="Center">
                                    <MenuItem Header="更多" Padding="10,5" ToolTip="语音、文件、位置、名片、链接、引用">
                                        <MenuItem Header="语音" Click="OnAddVoice"/>
                                        <MenuItem Header="视频" Click="OnAddVideo"/>
                                        <MenuItem Header="文件" Click="OnAddFile"/>
                                        <MenuItem Header="表情图片" Click="OnAddEmoji"/>
                                        <MenuItem Header="位置" Click="OnAddCard"/>
                                        <MenuItem Header="名片" Click="OnAddContact"/>
                                        <MenuItem Header="链接 / 小程序" Click="OnAddLink"/>
                                        <MenuItem Header="引用消息" Click="OnAddQuote"/>
                                        <MenuItem Header="收付款" Tag="payment" Click="OnAddMoneyMessage"/>
                                    </MenuItem>
                                </Menu>
                                <Menu Background="Transparent" VerticalAlignment="Center" Margin="6,0,0,0">
                                    <MenuItem Header="用已有记录" Padding="10,5" ToolTip="把某条已有记录变成一条新记录">
                                        <MenuItem Header="复制选中的那条" Click="OnCopySelected"/>
                                    </MenuItem>
                                </Menu>
                            </WrapPanel>
                            <Popup x:Name="EmojiPopup" PlacementTarget="{Binding ElementName=ComposerBox}"
                                   Placement="Top" StaysOpen="False" AllowsTransparency="True">
                                <Border Background="White" BorderBrush="#DADDE2" BorderThickness="1" CornerRadius="6" Padding="8">
                                    <WrapPanel x:Name="EmojiPanel" Width="320"/>
                                </Border>
                            </Popup>
                            <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Menu Background="Transparent" VerticalAlignment="Center">
                                <MenuItem Header="＋" FontSize="18" Padding="10,2" ToolTip="添加图片、文件等">
                                    <MenuItem Header="图片" Click="OnAddImage"/>
                                    <MenuItem Header="视频" Click="OnAddVideo"/>
                                    <MenuItem Header="语音" Click="OnAddVoice"/>
                                    <MenuItem Header="文件" Click="OnAddFile"/>
                                    <MenuItem Header="表情" Click="OnAddEmoji"/>
                                    <MenuItem Header="位置" Click="OnAddCard"/>
                                    <MenuItem Header="名片" Click="OnAddContact"/>
                                    <MenuItem Header="链接 / 小程序" Click="OnAddLink"/>
                                    <MenuItem Header="引用消息" Click="OnAddQuote"/>
                                <MenuItem Header="纯文字" Click="OnAddText"/>
                                    <Separator/>
                                    <MenuItem Header="转账" Tag="transfer" Click="OnAddMoneyMessage"/>
                                    <MenuItem Header="红包" Tag="redpacket" Click="OnAddMoneyMessage"/>
                                    <MenuItem Header="收付款" Tag="payment" Click="OnAddMoneyMessage"/>
                                </MenuItem>
                            </Menu>
                            <ComboBox x:Name="SendAsBox" Grid.Column="1" Width="104" SelectedIndex="0" Margin="6,0,0,0"
                                      VerticalAlignment="Center" ToolTip="这条记录算谁发的"
                                      SelectionChanged="OnSendBoxChanged">
                                <ComboBoxItem Content="我发送"/>
                                <ComboBoxItem Content="对方发送"/>
                            </ComboBox>
                            <TextBox x:Name="SenderNameBox" Grid.Column="2" Width="110" Margin="6,0,0,0" Height="30"
                                     VerticalAlignment="Center" Visibility="Collapsed"
                                     ToolTip="群聊里对方的名字（可留空）"/>
                            <TextBox x:Name="ComposerBox" Grid.Column="3" Height="34" Margin="8,0,8,0"
                                     VerticalContentAlignment="Center"
                                     ToolTip="在这里打字，然后点【发送】就能加一条记录"/>
                            <Button Grid.Column="4" Content="发送" Style="{StaticResource PrimaryButton}"
                                    Padding="18,6" Click="OnSendMessage" x:Name="SendButton"
                                    ToolTip="把这条记录加进聊天"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <ListBox x:Name="MessageList" SelectionChanged="OnMessageSelected"
                                 Background="#EDEDED" BorderThickness="0" Padding="6"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="4,2">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Row" Property="Background" Value="#D6E4FF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DayLabel}"
                                                   Visibility="{Binding ShowDay, Converter={StaticResource BoolToVis}}"
                                                   HorizontalAlignment="Center" Foreground="#8C959F"
                                                   FontSize="11" Margin="0,10,0,6"/>
                                        <Border Style="{StaticResource ChatBubbleStyle}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Sender}" FontSize="11" Foreground="#5A6472"
                                                           Visibility="{Binding ShowSender, Converter={StaticResource BoolToVis}}"
                                                           Margin="0,0,0,3"/>
                                                <TextBlock Text="{Binding DisplayBody}" TextWrapping="Wrap" FontSize="14"
                                                           Foreground="#141414"
                                                           Visibility="{Binding IsViewing, Converter={StaticResource BoolToVis}}"/>
                                                <!-- 转账 / 红包样式 -->
                                                <Border Style="{StaticResource TransactionCard}" Margin="0,2,0,0"
                                                        Visibility="{Binding IsTransaction, Converter={StaticResource BoolToVis}}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding CardTitle}" FontSize="13"
                                                                       Foreground="White"/>
                                                            <TextBlock Text="{Binding CardStatus}" FontSize="11"
                                                                       Foreground="#FFF3E0" Margin="0,3,0,0"
                                                                       Visibility="{Binding HasCardStatus, Converter={StaticResource BoolToVis}}"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding CardAmount}" FontSize="17"
                                                                   FontWeight="SemiBold" Foreground="White"
                                                                   VerticalAlignment="Center" Margin="14,0,0,0"
                                                                   Visibility="{Binding HasCardAmount, Converter={StaticResource BoolToVis}}"/>
                                                    </Grid>
                                                </Border>
                                                <Image Source="{Binding LocalImagePath}" MaxWidth="220" MaxHeight="220"
                                                       HorizontalAlignment="Left" Margin="0,6,0,0"
                                                       Visibility="{Binding HasLocalImage, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock Text="{Binding AttachmentNote}" FontSize="11" Foreground="#5A6472"
                                                           Margin="0,4,0,0"
                                                           Visibility="{Binding HasAttachmentNote, Converter={StaticResource BoolToVis}}"/>
                                                <!-- 就地编辑：和微信里改消息一样 -->
                                                <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                                                            MinWidth="260">
                                                    <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="220"
                                                             VerticalScrollBarVisibility="Auto" FontSize="14"/>
                                                    <DockPanel Margin="0,6,0,0">
                                                        <TextBlock DockPanel.Dock="Left" Text="时间" FontSize="12"
                                                                   Foreground="#5A6472" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBox Text="{Binding EditTime, UpdateSourceTrigger=PropertyChanged}"
                                                                 FontSize="12" Height="26" VerticalContentAlignment="Center"
                                                                 ToolTip="格式：2026-09-20 14:30（也可以只写 09-20 14:30）。改完自动按时间排序。"/>
                                                    </DockPanel>
                                                    <WrapPanel Margin="0,8,0,0">
                                                        <Button Content="保存" Padding="12,5" Click="OnBubbleSave"
                                                                ToolTip="保存这条修改"/>
                                                        <Button Content="取消" Padding="12,5" Margin="6,0,0,0" Click="OnBubbleCancel"/>
                                                        <Button Content="删除这条" Padding="12,5" Margin="6,0,0,0" Click="OnBubbleDelete"
                                                                ToolTip="从聊天里删掉这条记录"/>
                                                        <Button Content="换附件" Padding="12,5" Margin="6,0,0,0" Click="OnBubbleAttach"
                                                                Visibility="{Binding HasMediaSlot, Converter={StaticResource BoolToVis}}"/>
                                                        <Button Content="详细字段" Padding="12,5" Margin="6,0,0,0" Click="OnBubbleDetails"/>
                                                        <Button Content="改金额/备注" Padding="12,5" Margin="6,0,0,0" Click="OnBubbleMoney"
                                                                Visibility="{Binding IsTransaction, Converter={StaticResource BoolToVis}}"/>
                                                        <Button Content="复制一条" Padding="12,5" Margin="6,0,0,0" Click="OnBubbleCopy"
                                                                ToolTip="把这条记录复制成一条新记录，改一改就是你要的内容"/>
                                                    </WrapPanel>
                                                </StackPanel>
                                                <WrapPanel Margin="0,4,0,0"
                                                           Visibility="{Binding IsViewing, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding Time}" FontSize="11" Foreground="#5A6472" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding KindLabel}" FontSize="11" Foreground="#5A6472"
                                                               Visibility="{Binding HasKindLabel, Converter={StaticResource BoolToVis}}"/>
                                                    <Border Background="#F1F3F5" CornerRadius="3" Padding="4,0" Margin="6,0,0,0"
                                                            Visibility="{Binding IsDeleted, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="已删除" FontSize="10" Foreground="#8C2F2F"/>
                                                    </Border>
                                                    <Border Background="#FFF8E1" CornerRadius="3" Padding="4,0" Margin="6,0,0,0"
                                                            Visibility="{Binding IsTransaction, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="交易类" FontSize="10" Foreground="#7A5A00"/>
                                                    </Border>
                                                    <Border Background="#E8F0FE" CornerRadius="3" Padding="4,0" Margin="6,0,0,0"
                                                            Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="新增" FontSize="10" Foreground="#123C8C"/>
                                                    </Border>
                                                    <Border Background="#FDECEC" CornerRadius="3" Padding="4,0" Margin="6,0,0,0"
                                                            Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="已修改" FontSize="10" Foreground="#8C2F2F"/>
                                                    </Border>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <!-- 空状态 -->
                        <Border x:Name="EmptyState" Background="White">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="360">
                                <TextBlock Text="把手机上的聊天记录读到电脑上" FontSize="18" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Margin="0,10,0,18" TextWrapping="Wrap" Foreground="#6A737D" TextAlignment="Center"
                                           Text="用数据线连好手机，点下面的按钮。软件会先给手机上的记录做一份只读备份，再把联系人和聊天读出来，全程不动手机里的原始数据。"/>
                                <Button Content="读取微信记录" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center"
                                        Click="OnLoadFromPhone"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="3" Width="10" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- 右：改这一条 -->
            <Border Grid.Column="4" Background="White" CornerRadius="8" BorderBrush="#E4E6EA" BorderThickness="1"
                    x:Name="DetailPanel" Visibility="Collapsed">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="14,12,14,6">
                        <Grid>
                            <TextBlock Text="详细字段" FontSize="16" FontWeight="SemiBold"/>
                            <Button Content="收起" HorizontalAlignment="Right" Padding="10,3" FontSize="12" Click="OnHideDetails"/>
                        </Grid>
                        <TextBlock x:Name="EditorHint" Text="这里显示所选记录的原始字段，一般不用改" FontSize="12"
                                   Foreground="#8C959F" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="14,8,14,12">
                        <Button Content="保存修改" Style="{StaticResource PrimaryButton}" IsEnabled="False"
                                x:Name="EditButton" Click="OnSaveWorkspaceMessage"
                                ToolTip="把这条消息的改动保存到电脑上的副本"/>
                        <Button Content="撤销这条修改" Style="{StaticResource PlainButton}" Margin="0,8,0,0" IsEnabled="False"
                                x:Name="UndoButton" Click="OnUndoWorkspaceMessage"
                                ToolTip="恢复成原来的样子；新增的消息会被删掉"/>
                        <Expander Header="更多信息 / 时间调整" Margin="0,12,0,0">
                            <StackPanel Margin="4,8,4,0">
                                <TextBlock Text="原始时间" FontSize="12" Foreground="#6A737D"/>
                                <TextBox x:Name="PropertyTime" IsReadOnly="True" Margin="0,2,0,8"/>
                                <TextBlock Text="显示时间" FontSize="12" Foreground="#6A737D"/>
                                <TextBox x:Name="DateDisplay" IsReadOnly="True" Margin="0,2,0,8"/>
                                <TextBlock Text="排序位置" FontSize="12" Foreground="#6A737D"/>
                                <TextBox x:Name="DateSort" IsReadOnly="True" Margin="0,2,0,8"/>
                                <TextBlock Text="时区" FontSize="12" Foreground="#6A737D"/>
                                <TextBox x:Name="DateTimezone" IsReadOnly="True" Margin="0,2,0,8"/>
                                <WrapPanel>
                                    <Button x:Name="ShiftTimelineButton" Content="整体后移 1 分钟" Padding="10,5" IsEnabled="False"
                                            Click="OnShiftTimeline" ToolTip="把选中消息及之后的记录一起往后挪 1 分钟"/>
                                    <Button x:Name="ValidateTimelineButton" Content="检查时间顺序" Padding="10,5" Margin="6,0,0,0"
                                            IsEnabled="False" Click="OnValidateTimeline"/>
                                </WrapPanel>
                                <TextBlock Text="消息编号" FontSize="12" Foreground="#6A737D" Margin="0,12,0,0"/>
                                <TextBox x:Name="PropertyLocalId" IsReadOnly="True" Margin="0,2,0,8"/>
                                <TextBlock Text="服务器编号" FontSize="12" Foreground="#6A737D"/>
                                <TextBox x:Name="PropertyServerId" IsReadOnly="True" Margin="0,2,0,8"/>
                                <TextBlock Text="类型 / 原始类型" FontSize="12" Foreground="#6A737D"/>
                                <TextBox x:Name="PropertyType" IsReadOnly="True" Margin="0,2,0,8"/>
                                <TextBlock Text="发送方 / 方向 / 状态" FontSize="12" Foreground="#6A737D"/>
                                <TextBox x:Name="PropertySender" IsReadOnly="True" Margin="0,2,0,8"/>
                                <TextBox x:Name="PropertyDirection" IsReadOnly="True" Margin="0,2,0,8"/>
                                <TextBox x:Name="PropertyStatus" IsReadOnly="True" Margin="0,2,0,8"/>
                                <TextBlock Text="引用目标 / 提及" FontSize="12" Foreground="#6A737D"/>
                                <TextBox x:Name="PropertyQuote" IsReadOnly="True" Margin="0,2,0,8"/>
                                <TextBox x:Name="PropertyAtInfo" IsReadOnly="True" Margin="0,2,0,8"/>
                                <TextBlock Text="媒体类型 / 原文件 / 封面 / 尺寸 / 大小 / 时长" FontSize="12" Foreground="#6A737D"/>
                                <TextBox x:Name="MediaType" IsReadOnly="True" Margin="0,2,0,4"/>
                                <TextBox x:Name="MediaOriginalPath" IsReadOnly="True" Margin="0,0,0,4"/>
                                <TextBox x:Name="MediaThumbPath" IsReadOnly="True" Margin="0,0,0,4"/>
                                <TextBox x:Name="MediaDimensions" IsReadOnly="True" Margin="0,0,0,4"/>
                                <TextBox x:Name="MediaSize" IsReadOnly="True" Margin="0,0,0,4"/>
                                <TextBox x:Name="MediaDuration" IsReadOnly="True" Margin="0,0,0,4"/>
                                <TextBlock Text="标题 / 描述 / 链接 / 卡片 ID" FontSize="12" Foreground="#6A737D" Margin="0,8,0,0"/>
                                <TextBox x:Name="CardTitle" IsReadOnly="True" Margin="0,2,0,4"/>
                                <TextBox x:Name="CardDescription" IsReadOnly="True" Margin="0,0,0,4"/>
                                <TextBox x:Name="CardUrl" IsReadOnly="True" Margin="0,0,0,4"/>
                                <TextBox x:Name="CardAppId" IsReadOnly="True" Margin="0,0,0,4"/>
                                <TextBlock Text="位置地址 / 坐标" FontSize="12" Foreground="#6A737D" Margin="0,8,0,0"/>
                                <TextBox x:Name="LocationAddress" IsReadOnly="True" Margin="0,2,0,4"/>
                                <TextBox x:Name="LocationLatLng" IsReadOnly="True" Margin="0,0,0,4"/>
                                <TextBlock Text="引用内容 / 小程序 / 名片" FontSize="12" Foreground="#6A737D" Margin="0,8,0,0"/>
                                <TextBox x:Name="QuoteSenderBox" IsReadOnly="True" Margin="0,2,0,4"/>
                                <TextBox x:Name="QuoteContentBox" IsReadOnly="True" Height="60" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                <TextBox x:Name="MiniProgramUserNameBox" IsReadOnly="True" Margin="0,0,0,4"/>
                                <TextBox x:Name="MiniProgramPathBox" IsReadOnly="True" Margin="0,0,0,4"/>
                                <TextBox x:Name="ContactUserNameBox" IsReadOnly="True" Margin="0,0,0,4"/>
                                <TextBox x:Name="ContactNickNameBox" IsReadOnly="True" Margin="0,0,0,4"/>
                                <TextBlock Text="红包 / 转账" FontSize="12" Foreground="#6A737D" Margin="0,8,0,0"/>
                                <TextBox x:Name="TransactionType" IsReadOnly="True" Margin="0,2,0,4"/>
                                <TextBox x:Name="TransactionAmount" IsReadOnly="True" Margin="0,0,0,4"/>
                                <TextBox x:Name="TransactionStatus" IsReadOnly="True" Margin="0,0,0,4"/>
                                <TextBox x:Name="TransactionMemo" IsReadOnly="True" Height="56" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="14,4,14,0">
                        <StackPanel>
                            <CheckBox x:Name="ReadOnlyFlag" Content="交易类记录：可修改，改动会留痕" IsChecked="True"
                                      IsEnabled="False" Visibility="Collapsed" Margin="0,0,0,8"/>
                            <TextBlock Text="内容 / 说明" FontSize="13" Foreground="#3C4652"/>
                            <TextBox x:Name="PropertyContent" Height="150" TextWrapping="Wrap" AcceptsReturn="True"
                                     IsReadOnly="True" Margin="0,4,0,12"/>
                            <StackPanel x:Name="MediaGroup" Visibility="Collapsed">
                                <TextBlock Text="附件（图片、语音、视频、文件）" FontSize="13" Foreground="#3C4652"/>
                                <TextBox x:Name="PropertyAttachment" IsReadOnly="True" Margin="0,4,0,6"/>
                                <WrapPanel>
                                    <Button x:Name="ReplaceMediaButton" Content="选择文件" Padding="10,5" IsEnabled="False"
                                            Click="OnReplaceMedia"/>
                                    <Button x:Name="PreviewMediaButton" Content="打开预览" Padding="10,5" Margin="6,0,0,0"
                                            IsEnabled="False" Click="OnPreviewMedia"/>
                                </WrapPanel>
                                <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="#8C959F"
                                           Text="换完记得点下面的【保存修改】。"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
