<Window x:Class="WXDataStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WXDataStudio" Height="820" Width="1380" MinHeight="680" MinWidth="1100"
        WindowStartupLocation="CenterScreen">
    <DockPanel Background="#F4F5F7">
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#DADDE2" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="WXDataStudio" FontSize="22" FontWeight="SemiBold" Margin="0,0,22,0"/>
                    <Button Content="设备" Padding="14,7" Margin="0,0,8,0" Click="OnRefreshDevice"/>
                    <Button Content="快照" Padding="14,7" Margin="0,0,8,0" Click="OnCreateSnapshot"/>
                    <Button Content="工作副本" Padding="14,7" Margin="0,0,8,0" Click="OnOpenWorkspace"/>
                    <Button Content="完整性检查" Padding="14,7" Click="OnRunIntegrityCheck"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="9" Height="9" Fill="#2DA44E" Margin="0,0,7,0"/>
                    <TextBlock x:Name="DeviceBadge" Text="MIX 2S / WeChat 8.0.76 基线" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#DADDE2" BorderThickness="0,1,0,0" Height="150" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="日志 / 完整性检查" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <ListBox Grid.Row="1" x:Name="LogList" FontFamily="Consolas" FontSize="12"/>
            </Grid>
        </Border>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="6" Padding="12" BorderBrush="#E2E4E8" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="会话" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                    <TextBox DockPanel.Dock="Top" x:Name="SearchBox" Height="32" Margin="0,0,0,10" ToolTip="搜索联系人、群、关键词"/>
                    <ListBox x:Name="ConversationList" SelectionChanged="OnConversationSelected"/>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

            <Border Grid.Column="2" Background="White" CornerRadius="6" Padding="12" BorderBrush="#E2E4E8" BorderThickness="1">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="ConversationTitle" Text="请选择会话" FontWeight="SemiBold" FontSize="17"/>
                            <TextBlock Text="时间线预览（原始快照只读，编辑发生在工作副本）" Foreground="#6A737D" FontSize="12" Margin="0,3,0,0"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" Width="130" SelectedIndex="0">
                            <ComboBoxItem Content="全部消息"/>
                            <ComboBoxItem Content="文字"/>
                            <ComboBoxItem Content="图片/媒体"/>
                            <ComboBoxItem Content="系统消息"/>
                            <ComboBoxItem Content="交易类（只读）"/>
                        </ComboBox>
                    </Grid>
                    <ListBox x:Name="MessageList" SelectionChanged="OnMessageSelected"/>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

            <Border Grid.Column="4" Background="White" CornerRadius="6" Padding="14" BorderBrush="#E2E4E8" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="消息属性" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12"/>
                        <TextBlock Text="类型" Foreground="#6A737D"/>
                        <TextBlock x:Name="PropertyType" Text="-" Margin="0,2,0,10"/>
                        <TextBlock Text="时间" Foreground="#6A737D"/>
                        <TextBox x:Name="PropertyTime" Margin="0,2,0,10" IsReadOnly="True"/>
                        <TextBlock Text="发送方" Foreground="#6A737D"/>
                        <TextBox x:Name="PropertySender" Margin="0,2,0,10" IsReadOnly="True"/>
                        <TextBlock Text="内容 / 描述" Foreground="#6A737D"/>
                        <TextBox x:Name="PropertyContent" Height="150" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,2,0,10" IsReadOnly="True"/>
                        <TextBlock Text="附件" Foreground="#6A737D"/>
                        <TextBox x:Name="PropertyAttachment" Margin="0,2,0,10" IsReadOnly="True"/>
                        <CheckBox x:Name="ReadOnlyFlag" Content="敏感/交易凭证类：强制只读" IsChecked="True" IsEnabled="False" Visibility="Collapsed" Margin="0,4,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="编辑工作副本" Padding="12,7" Margin="0,0,8,0" IsEnabled="False" x:Name="EditButton"/>
                            <Button Content="撤销" Padding="12,7" IsEnabled="False" x:Name="UndoButton"/>
                        </StackPanel>
                        <Separator Margin="0,16,0,12"/>
                        <TextBlock Text="当前适配器" FontWeight="SemiBold"/>
                        <TextBlock Text="wechat-android-8.0.76-3141" TextWrapping="Wrap" Margin="0,4,0,4"/>
                        <TextBlock Text="写回功能：未开启（等待快照、解析、完整性和回滚验证通过）" Foreground="#9A6700" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
