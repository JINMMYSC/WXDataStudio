<Window x:Class="WXDataStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WXDataStudio" Height="900" Width="1540" MinHeight="720" MinWidth="1180"
        WindowStartupLocation="CenterScreen">
    <DockPanel Background="#F4F5F7">
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#DADDE2" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="WXDataStudio" FontSize="22" FontWeight="SemiBold" Margin="0,0,22,0"/>
                    <Button Content="设备" Padding="14,7" Margin="0,0,8,0" Click="OnRefreshDevice"/>
                    <Button Content="快照" Padding="14,7" Margin="0,0,8,0" Click="OnCreateSnapshot"/>
                    <Button Content="解析快照" Padding="14,7" Margin="0,0,8,0" Click="OnAnalyzeSnapshot"/>
                    <Button Content="选择快照" Padding="14,7" Margin="0,0,8,0" Click="OnSelectSnapshot"/>
                    <Button Content="数据库诊断" Padding="14,7" Margin="0,0,8,0" Click="OnDatabaseDiagnostics"/>
                    <Button Content="数据库密钥" Padding="14,7" Margin="0,0,8,0" Click="OnDatabaseKey"/>
                    <Button Content="密钥诊断" Padding="14,7" Margin="0,0,8,0" Click="OnKeyDiagnostics"/>
                    <Button Content="工作副本" Padding="14,7" Margin="0,0,8,0" Click="OnOpenWorkspace"/>
                    <Button Content="差异" Padding="14,7" Margin="0,0,8,0" Click="OnShowDiff"/>
                    <Button Content="完整性检查" Padding="14,7" Margin="0,0,8,0" Click="OnRunIntegrityCheck"/>
                    <Button Content="回滚包" Padding="14,7" Margin="0,0,8,0" Click="OnCreateRollbackPackage"/>
                    <Button Content="迁移检查" Padding="14,7" Click="OnMigrationCheck"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="DeviceIndicator" Width="9" Height="9" Fill="#8C959F" Margin="0,0,7,0"/>
                    <StackPanel>
                        <TextBlock x:Name="DeviceBadge" Text="离线模式 / 正在检查"/>
                        <TextBlock x:Name="SnapshotBadge" Text="正在检查本地快照..." FontSize="11" Foreground="#6A737D"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#DADDE2" BorderThickness="0,1,0,0" Height="145" Padding="12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="日志 / 完整性检查" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <ListBox Grid.Row="1" x:Name="LogList" FontFamily="Consolas" FontSize="12"/>
            </Grid>
        </Border>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/><ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/>
                <ColumnDefinition Width="440"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="6" Padding="12" BorderBrush="#E2E4E8" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="会话" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                    <TextBox DockPanel.Dock="Top" x:Name="SearchBox" Height="32" Margin="0,0,0,10" ToolTip="搜索联系人、群、关键词" TextChanged="OnSearchChanged"/>
                    <ListBox x:Name="ConversationList" SelectionChanged="OnConversationSelected"/>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>            <Border Grid.Column="2" Background="White" CornerRadius="6" Padding="12" BorderBrush="#E2E4E8" BorderThickness="1">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="ConversationTitle" Text="请选择会话" FontWeight="SemiBold" FontSize="17"/>
                            <TextBlock Text="时间线预览；原始快照只读，编辑只发生在工作副本" Foreground="#6A737D" FontSize="12" Margin="0,3,0,0"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" Width="150" SelectedIndex="0" x:Name="MessageFilter" SelectionChanged="OnMessageFilterChanged">
                            <ComboBoxItem Content="全部消息"/><ComboBoxItem Content="文字"/>
                            <ComboBoxItem Content="图片/媒体"/><ComboBoxItem Content="卡片/位置"/>
                            <ComboBoxItem Content="系统消息"/><ComboBoxItem Content="交易类（只读）"/>
                        </ComboBox>
                        <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0">
                            <Button Content="+ 文字" Padding="10,5" Margin="0,0,6,0" IsEnabled="False" x:Name="AddTextButton" Click="OnAddText"/>
                            <Button Content="+ 图片" Padding="10,5" Margin="0,0,6,0" IsEnabled="False" x:Name="AddImageButton" Click="OnAddImage"/>
                            <Button Content="+ 视频" Padding="10,5" Margin="0,0,6,0" IsEnabled="False" x:Name="AddVideoButton" Click="OnAddVideo"/>
                            <Button Content="+ 语音" Padding="10,5" Margin="0,0,6,0" IsEnabled="False" x:Name="AddVoiceButton" Click="OnAddVoice"/>
                            <Button Content="+ 文件" Padding="10,5" Margin="0,0,6,0" IsEnabled="False" x:Name="AddFileButton" Click="OnAddFile"/>
                            <Button Content="+ 位置/卡片" Padding="10,5" Margin="0,0,6,0" IsEnabled="False" x:Name="AddCardButton" Click="OnAddCard"/>
                            <Button Content="+ 表情" Padding="10,5" Margin="0,0,6,0" IsEnabled="False" x:Name="AddEmojiButton" Click="OnAddEmoji"/>
                            <Button Content="+ 名片" Padding="10,5" Margin="0,0,6,0" IsEnabled="False" x:Name="AddContactButton" Click="OnAddContact"/>
                            <Button Content="+ 链接/小程序" Padding="10,5" Margin="0,0,6,0" IsEnabled="False" x:Name="AddLinkButton" Click="OnAddLink"/>
                            <Button Content="+ 引用" Padding="10,5" IsEnabled="False" x:Name="AddQuoteButton" Click="OnAddQuote"/>
                        </WrapPanel>
                    </Grid>
                    <ListBox x:Name="MessageList" SelectionChanged="OnMessageSelected"/>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>            <Border Grid.Column="4" Background="White" CornerRadius="6" Padding="12" BorderBrush="#E2E4E8" BorderThickness="1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="消息编辑器" FontWeight="SemiBold" FontSize="16"/>
                        <TextBlock Text="支持工作副本文字、媒体、日期和卡片编辑；交易/红包/收付款只读" Foreground="#6A737D" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,8"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <CheckBox x:Name="ReadOnlyFlag" Content="敏感/交易凭证类：强制只读" IsChecked="True" IsEnabled="False" Visibility="Collapsed" Margin="0,0,0,8"/>
                        <WrapPanel>
                            <Button Content="保存工作副本" Padding="12,7" Margin="0,0,8,0" IsEnabled="False" x:Name="EditButton" Click="OnSaveWorkspaceMessage"/>
                            <Button Content="撤销" Padding="12,7" IsEnabled="False" x:Name="UndoButton" Click="OnUndoWorkspaceMessage"/>
                        </WrapPanel>
                        <TextBlock Text="当前适配器：wechat-android-8.0.76-3141" Margin="0,9,0,0" FontSize="11" Foreground="#6A737D"/>
                        <TextBlock Text="真实写回尚未开启；先完成解析、快照、回滚和一致性验证。" Foreground="#9A6700" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TabControl x:Name="EditorTabs">
                        <TabItem Header="通用"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8">
                            <TextBlock Text="消息类型"/><TextBlock x:Name="PropertyType" Text="-" FontWeight="SemiBold" Margin="0,2,0,8"/>
                            <TextBlock Text="发送方"/><TextBox x:Name="PropertySender" IsReadOnly="True" Margin="0,2,0,8"/>
                            <TextBlock Text="方向"/><TextBox x:Name="PropertyDirection" IsReadOnly="True" Margin="0,2,0,8"/>
                            <TextBlock Text="状态"/><TextBox x:Name="PropertyStatus" IsReadOnly="True" Margin="0,2,0,8"/>
                            <TextBlock Text="Local ID"/><TextBox x:Name="PropertyLocalId" IsReadOnly="True" Margin="0,2,0,8"/>
                            <TextBlock Text="Server ID"/><TextBox x:Name="PropertyServerId" IsReadOnly="True" Margin="0,2,0,8"/>
                        </StackPanel></ScrollViewer></TabItem>                        <TabItem Header="内容"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8">
                            <TextBlock Text="正文 / 描述"/><TextBox x:Name="PropertyContent" Height="150" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" Margin="0,2,0,8"/>
                            <TextBlock Text="引用目标"/><TextBox x:Name="PropertyQuote" IsReadOnly="True" Margin="0,2,0,8"/>
                            <TextBlock Text="@ / 提及信息"/><TextBox x:Name="PropertyAtInfo" IsReadOnly="True" Margin="0,2,0,8"/>
                            <TextBlock Text="附件摘要"/><TextBox x:Name="PropertyAttachment" IsReadOnly="True" Margin="0,2,0,8"/>
                        </StackPanel></ScrollViewer></TabItem>

                        <TabItem Header="媒体"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8">
                            <TextBlock Text="媒体类型"/><TextBox x:Name="MediaType" IsReadOnly="True" Margin="0,2,0,8"/>
                            <TextBlock Text="原始文件"/><TextBox x:Name="MediaOriginalPath" IsReadOnly="True" Margin="0,2,0,8"/>
                            <TextBlock Text="缩略图 / 封面"/><TextBox x:Name="MediaThumbPath" IsReadOnly="True" Margin="0,2,0,8"/>
                            <TextBlock Text="尺寸 / 分辨率"/><TextBox x:Name="MediaDimensions" IsReadOnly="True" Margin="0,2,0,8"/>
                            <TextBlock Text="大小"/><TextBox x:Name="MediaSize" IsReadOnly="True" Margin="0,2,0,8"/>
                            <TextBlock Text="时长"/><TextBox x:Name="MediaDuration" IsReadOnly="True" Margin="0,2,0,8"/>
                            <WrapPanel><Button x:Name="ReplaceMediaButton" Content="选择图片/文件" Padding="10,5" IsEnabled="False" Click="OnReplaceMedia"/><Button x:Name="PreviewMediaButton" Content="预览" Padding="10,5" Margin="6,0,0,0" IsEnabled="False" Click="OnPreviewMedia"/></WrapPanel>
                        </StackPanel></ScrollViewer></TabItem>                        <TabItem Header="日期"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8">
                            <TextBlock Text="原始时间"/><TextBox x:Name="PropertyTime" IsReadOnly="True" Margin="0,2,0,8"/>
                            <TextBlock Text="显示时间"/><TextBox x:Name="DateDisplay" IsReadOnly="True" Margin="0,2,0,8"/>
                            <TextBlock Text="排序时间 / sequence"/><TextBox x:Name="DateSort" IsReadOnly="True" Margin="0,2,0,8"/>
                            <TextBlock Text="时区"/><TextBox x:Name="DateTimezone" IsReadOnly="True" Margin="0,2,0,8"/>
                            <WrapPanel><Button Content="批量顺延" Padding="10,5" IsEnabled="False"/><Button x:Name="ValidateTimelineButton" Content="校验时间线" Padding="10,5" Margin="6,0,0,0" IsEnabled="False" Click="OnValidateTimeline"/></WrapPanel>
                        </StackPanel></ScrollViewer></TabItem>

                        <TabItem Header="位置/卡片"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8">
                            <TextBlock Text="标题"/><TextBox x:Name="CardTitle" IsReadOnly="True" Margin="0,2,0,8"/>
                            <TextBlock Text="描述"/><TextBox x:Name="CardDescription" IsReadOnly="True" Margin="0,2,0,8"/>
                            <TextBlock Text="URL"/><TextBox x:Name="CardUrl" IsReadOnly="True" Margin="0,2,0,8"/>
                            <TextBlock Text="AppId / 卡片 ID"/><TextBox x:Name="CardAppId" IsReadOnly="True" Margin="0,2,0,8"/>
                            <TextBlock Text="地址"/><TextBox x:Name="LocationAddress" IsReadOnly="True" Margin="0,2,0,8"/>
                            <TextBlock Text="经度 / 纬度"/><TextBox x:Name="LocationLatLng" IsReadOnly="True" Margin="0,2,0,8"/>
                        </StackPanel></ScrollViewer></TabItem>
                        <TabItem Header="引用/小程序/名片"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8">
                            <TextBlock Text="引用发送者"/><TextBox x:Name="QuoteSenderBox" IsReadOnly="True" Margin="0,2,0,8"/>
                            <TextBlock Text="引用内容"/><TextBox x:Name="QuoteContentBox" IsReadOnly="True" TextWrapping="Wrap" Height="76" Margin="0,2,0,8"/>
                            <TextBlock Text="小程序用户名"/><TextBox x:Name="MiniProgramUserNameBox" IsReadOnly="True" Margin="0,2,0,8"/>
                            <TextBlock Text="小程序路径"/><TextBox x:Name="MiniProgramPathBox" IsReadOnly="True" Margin="0,2,0,8"/>
                            <TextBlock Text="名片用户名"/><TextBox x:Name="ContactUserNameBox" IsReadOnly="True" Margin="0,2,0,8"/>
                            <TextBlock Text="名片昵称"/><TextBox x:Name="ContactNickNameBox" IsReadOnly="True" Margin="0,2,0,8"/>
                        </StackPanel></ScrollViewer></TabItem>
                        <TabItem Header="交易/红包"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8">
                            <Border Background="#FFF8E1" BorderBrush="#E5B300" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,10">
                                <TextBlock Text="交易、红包、收付款和账单类记录只做读取与展示，不作为可伪造凭证写回。" TextWrapping="Wrap" Foreground="#7A5A00"/>
                            </Border>
                            <TextBlock Text="类别"/><TextBox x:Name="TransactionType" IsReadOnly="True" Margin="0,2,0,8"/>
                            <TextBlock Text="金额 / 显示值"/><TextBox x:Name="TransactionAmount" IsReadOnly="True" Margin="0,2,0,8"/>
                            <TextBlock Text="状态"/><TextBox x:Name="TransactionStatus" IsReadOnly="True" Margin="0,2,0,8"/>
                            <TextBlock Text="说明 / 备注"/><TextBox x:Name="TransactionMemo" IsReadOnly="True" TextWrapping="Wrap" Height="90" Margin="0,2,0,8"/>
                        </StackPanel></ScrollViewer></TabItem>
                    </TabControl>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>