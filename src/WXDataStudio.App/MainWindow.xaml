<Window x:Class="WXDataStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WXDataStudio" Height="900" Width="1540" MinHeight="720" MinWidth="1180"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="ChatBubbleStyle" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E4E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="4,3,4,3"/>
            <Setter Property="MaxWidth" Value="560"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOutgoing}" Value="True">
                    <Setter Property="HorizontalAlignment" Value="Right"/>
                    <Setter Property="Background" Value="#95EC69"/>
                    <Setter Property="BorderBrush" Value="#86D95E"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <DockPanel Background="#F4F5F7">
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#DADDE2" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="WXDataStudio" FontSize="22" FontWeight="SemiBold" Margin="0,0,22,0"/>
                    <Button Content="设备" Padding="14,7" Margin="0,0,8,0" Click="OnRefreshDevice" ToolTip="第 1 步：通过 ADB 检测手机、Root 与微信版本"/>
                    <Button Content="快照" Padding="14,7" Margin="0,0,8,0" Click="OnCreateSnapshot" ToolTip="第 2 步：暂停微信并创建只读本地快照（含大小与 SHA-256 清单）"/>
                    <Button Content="解析快照" Padding="14,7" Margin="0,0,8,0" Click="OnAnalyzeSnapshot" ToolTip="第 3 步：只读打开快照数据库并读取会话列表"/>
                    <Button Content="选择快照" Padding="14,7" Margin="0,0,8,0" Click="OnSelectSnapshot" ToolTip="切换到其它目录中已有的快照"/>
                    <Button Content="工作副本" Padding="14,7" Margin="0,0,8,0" Click="OnOpenWorkspace" ToolTip="第 5 步：打开可编辑副本；不打开就无法新增或修改聊天记录"/>
                    <Button Content="差异" Padding="14,7" Margin="0,0,8,0" Click="OnShowDiff" ToolTip="查看当前工作副本的全部改动"/>
                    <Button Content="迁移检查" Padding="14,7" Margin="0,0,8,0" Click="OnMigrationCheck" ToolTip="生成迁移准备报告（JSON + 文本）"/>
                    <Button Content="导出会话" Padding="14,7" Margin="0,0,8,0" Click="OnExportConversation" ToolTip="第 9 步：把当前会话导出为 HTML 记录与 JSON 数据，只保存在本机"/>
                    <Menu Background="Transparent" VerticalAlignment="Center" Padding="0" Margin="0,0,4,0">
                        <MenuItem Header="更多" Padding="12,7" ToolTip="诊断、完整性检查、回滚包与真机自检">
                            <MenuItem Header="数据库诊断" Click="OnDatabaseDiagnostics"/>
                            <MenuItem Header="数据库密钥" Click="OnDatabaseKey"/>
                            <MenuItem Header="密钥诊断" Click="OnKeyDiagnostics"/>
                            <MenuItem Header="完整性检查" Click="OnRunIntegrityCheck"/>
                            <MenuItem Header="回滚包" Click="OnCreateRollbackPackage"/>
                            <Separator/>
                            <MenuItem Header="阶段三只读验收" Click="OnStage3Acceptance"/>
                        </MenuItem>
                    </Menu>
                </WrapPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="DeviceIndicator" Width="9" Height="9" Fill="#8C959F" Margin="0,0,7,0"/>
                    <StackPanel>
                        <TextBlock x:Name="DeviceBadge" Text="离线模式 / 正在检查"/>
                        <TextBlock x:Name="SnapshotBadge" Text="正在检查本地快照..." FontSize="11" Foreground="#6A737D"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top" Background="#EEF4FF" BorderBrush="#C9DCFF" BorderThickness="0,0,0,1" Padding="14,7">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="GuideHint" VerticalAlignment="Center" Foreground="#123C8C"
                           TextTrimming="CharacterEllipsis"
                           Text="第 1 步：点【设备】检查手机连接，再点【快照】建立本地只读快照。"/>
                <Button Grid.Column="1" Content="使用教程" Padding="12,5" Margin="12,0,0,0" Click="OnShowGuide"
                        ToolTip="打开分步教程：如何新增、修改、撤销聊天记录并导出报告"/>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#DADDE2" BorderThickness="0,1,0,0" Height="145" Padding="12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="日志 / 完整性检查" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <ListBox Grid.Row="1" x:Name="LogList" FontFamily="Consolas" FontSize="12"/>
            </Grid>
        </Border>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/><ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/>
                <ColumnDefinition Width="440"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="6" Padding="12" BorderBrush="#E2E4E8" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="会话" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                    <TextBox DockPanel.Dock="Top" x:Name="SearchBox" Height="32" Margin="0,0,0,10" ToolTip="搜索联系人、群、关键词" TextChanged="OnSearchChanged"/>
                    <ListBox x:Name="ConversationList" SelectionChanged="OnConversationSelected"/>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>            <Border Grid.Column="2" Background="White" CornerRadius="6" Padding="12" BorderBrush="#E2E4E8" BorderThickness="1">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="ConversationTitle" Text="请选择会话" FontWeight="SemiBold" FontSize="17"/>
                            <TextBlock Text="时间线预览；原始快照只读，编辑只发生在工作副本" Foreground="#6A737D" FontSize="12" Margin="0,3,0,0"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" Width="150" SelectedIndex="0" x:Name="MessageFilter" SelectionChanged="OnMessageFilterChanged">
                            <ComboBoxItem Content="全部消息"/><ComboBoxItem Content="文字"/>
                            <ComboBoxItem Content="图片/媒体"/><ComboBoxItem Content="卡片/位置"/>
                            <ComboBoxItem Content="系统消息"/><ComboBoxItem Content="交易类"/>
                        </ComboBox>
                        <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0">
                            <Button Content="+ 文字" Padding="10,5" Margin="0,0,6,0" IsEnabled="False" x:Name="AddTextButton" Click="OnAddText" ToolTip="在工作副本中新增一条文字消息（需先打开工作副本）"/>
                            <Button Content="+ 图片" Padding="10,5" Margin="0,0,6,0" IsEnabled="False" x:Name="AddImageButton" Click="OnAddImage" ToolTip="选择本地图片并新增一条图片消息，文件会复制进工作副本"/>
                            <Button Content="+ 视频" Padding="10,5" Margin="0,0,6,0" IsEnabled="False" x:Name="AddVideoButton" Click="OnAddVideo" ToolTip="选择本地视频并新增一条视频消息"/>
                            <Button Content="+ 语音" Padding="10,5" Margin="0,0,6,0" IsEnabled="False" x:Name="AddVoiceButton" Click="OnAddVoice" ToolTip="选择本地音频并新增一条语音消息"/>
                            <Button Content="+ 文件" Padding="10,5" Margin="0,0,6,0" IsEnabled="False" x:Name="AddFileButton" Click="OnAddFile" ToolTip="选择任意本地文件并新增一条文件消息"/>
                            <Button Content="+ 位置/卡片" Padding="10,5" Margin="0,0,6,0" IsEnabled="False" x:Name="AddCardButton" Click="OnAddCard" ToolTip="新增位置/卡片消息草稿，随后在右侧编辑字段"/>
                            <Button Content="+ 表情" Padding="10,5" Margin="0,0,6,0" IsEnabled="False" x:Name="AddEmojiButton" Click="OnAddEmoji" ToolTip="选择表情图片并新增一条表情消息"/>
                            <Button Content="+ 名片" Padding="10,5" Margin="0,0,6,0" IsEnabled="False" x:Name="AddContactButton" Click="OnAddContact" ToolTip="新增名片消息草稿，随后填写用户名与昵称"/>
                            <Button Content="+ 链接/小程序" Padding="10,5" Margin="0,0,6,0" IsEnabled="False" x:Name="AddLinkButton" Click="OnAddLink" ToolTip="新增链接/小程序消息草稿，随后填写标题与 URL"/>
                            <Button Content="+ 引用" Padding="10,5" IsEnabled="False" x:Name="AddQuoteButton" Click="OnAddQuote" ToolTip="新增引用消息草稿，随后填写引用发送者与引用内容"/>
                        </WrapPanel>
                    </Grid>
                    <TextBox DockPanel.Dock="Top" x:Name="MessageSearchBox" Height="30" Margin="0,0,0,8"
                             ToolTip="搜索当前会话的正文、发送者、附件或消息 ID"
                             TextChanged="OnMessageSearchChanged"/>
                    <ListBox x:Name="MessageList" SelectionChanged="OnMessageSelected"
                             Background="#EDEDED" BorderThickness="0" Padding="6"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="4,2">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="#D6E4FF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding DayLabel}"
                                               Visibility="{Binding ShowDay, Converter={StaticResource BoolToVis}}"
                                               HorizontalAlignment="Center" Foreground="#8C959F"
                                               FontSize="11" Margin="0,10,0,6"/>
                                    <Border Style="{StaticResource ChatBubbleStyle}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Sender}" FontSize="11" Foreground="#5A6472"
                                                       Visibility="{Binding ShowSender, Converter={StaticResource BoolToVis}}"
                                                       Margin="0,0,0,3"/>
                                            <TextBlock Text="{Binding Body}" TextWrapping="Wrap" FontSize="14"
                                                       Foreground="#141414"/>
                                            <Image Source="{Binding LocalImagePath}" MaxWidth="220" MaxHeight="220"
                                                   HorizontalAlignment="Left" Margin="0,6,0,0"
                                                   Visibility="{Binding HasLocalImage, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="{Binding AttachmentNote}" FontSize="11" Foreground="#5A6472"
                                                       Margin="0,4,0,0"
                                                       Visibility="{Binding HasAttachmentNote, Converter={StaticResource BoolToVis}}"/>
                                            <WrapPanel Margin="0,4,0,0">
                                                <TextBlock Text="{Binding Time}" FontSize="11" Foreground="#5A6472" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding KindLabel}" FontSize="11" Foreground="#5A6472"
                                                           Visibility="{Binding HasKindLabel, Converter={StaticResource BoolToVis}}"/>
                                                <Border Background="#FFF8E1" CornerRadius="3" Padding="4,0" Margin="6,0,0,0"
                                                        Visibility="{Binding IsTransaction, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="交易类" FontSize="10" Foreground="#7A5A00"/>
                                                </Border>
                                                <Border Background="#E8F0FE" CornerRadius="3" Padding="4,0" Margin="6,0,0,0"
                                                        Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="新增" FontSize="10" Foreground="#123C8C"/>
                                                </Border>
                                                <Border Background="#FDECEC" CornerRadius="3" Padding="4,0" Margin="6,0,0,0"
                                                        Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="已修改" FontSize="10" Foreground="#8C2F2F"/>
                                                </Border>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>            <Border Grid.Column="4" Background="White" CornerRadius="6" Padding="12" BorderBrush="#E2E4E8" BorderThickness="1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="消息编辑器" FontWeight="SemiBold" FontSize="16"/>
                        <TextBlock Text="支持文字、媒体、日期与各类卡片编辑；改完点【保存工作副本】" Foreground="#6A737D" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,8"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <CheckBox x:Name="ReadOnlyFlag" Content="交易类记录：可编辑，改动会写入审计" IsChecked="True" IsEnabled="False" Visibility="Collapsed" Margin="0,0,0,8"/>
                        <WrapPanel>
                            <Button Content="保存工作副本" Padding="12,7" Margin="0,0,8,0" IsEnabled="False" x:Name="EditButton" Click="OnSaveWorkspaceMessage"
                                    ToolTip="把右侧的正文、附件和时间改动写入工作副本 JSON（不保存就不会保留）"/>
                            <Button Content="撤销" Padding="12,7" IsEnabled="False" x:Name="UndoButton" Click="OnUndoWorkspaceMessage"
                                    ToolTip="把选中消息恢复为原始内容；新增的消息会被删除"/>
                        </WrapPanel>
                        <TextBlock Text="当前适配器：wechat-android-8.0.76-3141" Margin="0,9,0,0" FontSize="11" Foreground="#6A737D"/>
                        <TextBlock Text="真实写回尚未开启；先完成解析、快照、回滚和一致性验证。" Foreground="#9A6700" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TabControl x:Name="EditorTabs">
                        <TabItem Header="通用"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8">
                            <TextBlock Text="消息类型"/><TextBlock x:Name="PropertyType" Text="-" FontWeight="SemiBold" Margin="0,2,0,8"/>
                            <TextBlock Text="发送方"/><TextBox x:Name="PropertySender" IsReadOnly="True" Margin="0,2,0,8"/>
                            <TextBlock Text="方向"/><TextBox x:Name="PropertyDirection" IsReadOnly="True" Margin="0,2,0,8"/>
                            <TextBlock Text="状态"/><TextBox x:Name="PropertyStatus" IsReadOnly="True" Margin="0,2,0,8"/>
                            <TextBlock Text="Local ID"/><TextBox x:Name="PropertyLocalId" IsReadOnly="True" Margin="0,2,0,8"/>
                            <TextBlock Text="Server ID"/><TextBox x:Name="PropertyServerId" IsReadOnly="True" Margin="0,2,0,8"/>
                        </StackPanel></ScrollViewer></TabItem>                        <TabItem Header="内容"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8">
                            <TextBlock Text="正文 / 描述"/><TextBox x:Name="PropertyContent" Height="150" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" Margin="0,2,0,8"/>
                            <TextBlock Text="引用目标"/><TextBox x:Name="PropertyQuote" IsReadOnly="True" Margin="0,2,0,8"/>
                            <TextBlock Text="@ / 提及信息"/><TextBox x:Name="PropertyAtInfo" IsReadOnly="True" Margin="0,2,0,8"/>
                            <TextBlock Text="附件摘要"/><TextBox x:Name="PropertyAttachment" IsReadOnly="True" Margin="0,2,0,8"/>
                        </StackPanel></ScrollViewer></TabItem>

                        <TabItem Header="媒体"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8">
                            <TextBlock Text="媒体类型"/><TextBox x:Name="MediaType" IsReadOnly="True" Margin="0,2,0,8"/>
                            <TextBlock Text="原始文件"/><TextBox x:Name="MediaOriginalPath" IsReadOnly="True" Margin="0,2,0,8"/>
                            <TextBlock Text="缩略图 / 封面"/><TextBox x:Name="MediaThumbPath" IsReadOnly="True" Margin="0,2,0,8"/>
                            <TextBlock Text="尺寸 / 分辨率"/><TextBox x:Name="MediaDimensions" IsReadOnly="True" Margin="0,2,0,8"/>
                            <TextBlock Text="大小"/><TextBox x:Name="MediaSize" IsReadOnly="True" Margin="0,2,0,8"/>
                            <TextBlock Text="时长"/><TextBox x:Name="MediaDuration" IsReadOnly="True" Margin="0,2,0,8"/>
                            <WrapPanel><Button x:Name="ReplaceMediaButton" Content="选择图片/文件" Padding="10,5" IsEnabled="False" Click="OnReplaceMedia"/><Button x:Name="PreviewMediaButton" Content="预览" Padding="10,5" Margin="6,0,0,0" IsEnabled="False" Click="OnPreviewMedia"/></WrapPanel>
                        </StackPanel></ScrollViewer></TabItem>                        <TabItem Header="日期"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8">
                            <TextBlock Text="原始时间"/><TextBox x:Name="PropertyTime" IsReadOnly="True" Margin="0,2,0,8"/>
                            <TextBlock Text="显示时间"/><TextBox x:Name="DateDisplay" IsReadOnly="True" Margin="0,2,0,8"/>
                            <TextBlock Text="排序时间 / sequence"/><TextBox x:Name="DateSort" IsReadOnly="True" Margin="0,2,0,8"/>
                            <TextBlock Text="时区"/><TextBox x:Name="DateTimezone" IsReadOnly="True" Margin="0,2,0,8"/>
                            <WrapPanel><Button x:Name="ShiftTimelineButton" Content="批量顺延 60 秒" Padding="10,5" IsEnabled="False" Click="OnShiftTimeline"
                                               ToolTip="把选中消息及其之后的所有消息整体推后 60 秒，用于腾出插入空间"/><Button x:Name="ValidateTimelineButton" Content="校验时间线" Padding="10,5" Margin="6,0,0,0" IsEnabled="False" Click="OnValidateTimeline"/></WrapPanel>
                        </StackPanel></ScrollViewer></TabItem>

                        <TabItem Header="位置/卡片"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8">
                            <TextBlock Text="标题"/><TextBox x:Name="CardTitle" IsReadOnly="True" Margin="0,2,0,8"/>
                            <TextBlock Text="描述"/><TextBox x:Name="CardDescription" IsReadOnly="True" Margin="0,2,0,8"/>
                            <TextBlock Text="URL"/><TextBox x:Name="CardUrl" IsReadOnly="True" Margin="0,2,0,8"/>
                            <TextBlock Text="AppId / 卡片 ID"/><TextBox x:Name="CardAppId" IsReadOnly="True" Margin="0,2,0,8"/>
                            <TextBlock Text="地址"/><TextBox x:Name="LocationAddress" IsReadOnly="True" Margin="0,2,0,8"/>
                            <TextBlock Text="经度 / 纬度"/><TextBox x:Name="LocationLatLng" IsReadOnly="True" Margin="0,2,0,8"/>
                        </StackPanel></ScrollViewer></TabItem>
                        <TabItem Header="引用/小程序/名片"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8">
                            <TextBlock Text="引用发送者"/><TextBox x:Name="QuoteSenderBox" IsReadOnly="True" Margin="0,2,0,8"/>
                            <TextBlock Text="引用内容"/><TextBox x:Name="QuoteContentBox" IsReadOnly="True" TextWrapping="Wrap" Height="76" Margin="0,2,0,8"/>
                            <TextBlock Text="小程序用户名"/><TextBox x:Name="MiniProgramUserNameBox" IsReadOnly="True" Margin="0,2,0,8"/>
                            <TextBlock Text="小程序路径"/><TextBox x:Name="MiniProgramPathBox" IsReadOnly="True" Margin="0,2,0,8"/>
                            <TextBlock Text="名片用户名"/><TextBox x:Name="ContactUserNameBox" IsReadOnly="True" Margin="0,2,0,8"/>
                            <TextBlock Text="名片昵称"/><TextBox x:Name="ContactNickNameBox" IsReadOnly="True" Margin="0,2,0,8"/>
                        </StackPanel></ScrollViewer></TabItem>
                        <TabItem Header="交易/红包"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8">
                            <Border Background="#FFF8E1" BorderBrush="#E5B300" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,10">
                                <TextBlock Text="交易类记录可以编辑，用于恢复误删内容；请只填写真实发生过的信息，所有改动都会留在审计记录与差异中。" TextWrapping="Wrap" Foreground="#7A5A00"/>
                            </Border>
                            <TextBlock Text="类别"/><TextBox x:Name="TransactionType" IsReadOnly="True" Margin="0,2,0,8"/>
                            <TextBlock Text="金额 / 显示值"/><TextBox x:Name="TransactionAmount" IsReadOnly="True" Margin="0,2,0,8"/>
                            <TextBlock Text="状态"/><TextBox x:Name="TransactionStatus" IsReadOnly="True" Margin="0,2,0,8"/>
                            <TextBlock Text="说明 / 备注"/><TextBox x:Name="TransactionMemo" IsReadOnly="True" TextWrapping="Wrap" Height="90" Margin="0,2,0,8"/>
                        </StackPanel></ScrollViewer></TabItem>
                    </TabControl>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
