<Window x:Class="WXDataStudio.App.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="使用教程 · WXDataStudio" Height="820" Width="920" MinHeight="600" MinWidth="720"
        WindowStartupLocation="CenterOwner" Background="#F4F5F7">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#DADDE2" BorderThickness="0,0,0,1" Padding="18,14">
            <StackPanel>
                <TextBlock Text="使用教程" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Margin="0,6,0,0" Foreground="#5A6472" TextWrapping="Wrap"
                           Text="按第 1 步到第 9 步顺序操作即可完成“建立快照 → 解析 → 新增/修改聊天记录 → 校验与导出”。所有按钮名称与主界面一致。"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#DADDE2" BorderThickness="0,1,0,0" Padding="18,12">
            <Grid>
                <TextBlock VerticalAlignment="Center" Foreground="#5A6472"
                           Text="教程随时可从主界面顶部的“使用教程”按钮再次打开。"/>
                <Button Content="关闭" Width="96" Padding="0,7" HorizontalAlignment="Right" Click="OnClose"/>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,14">
            <StackPanel>
                <Border Background="#FFF8E1" BorderBrush="#E5B300" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="先明确三条边界" FontWeight="SemiBold" Foreground="#7A5A00"/>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#7A5A00"
                                   Text="1) 手机原始数据库只读，本软件不会改写手机上的微信数据。&#10;2) 交易、红包、收付款、账单类记录始终只读，不能新增也不能修改。&#10;3) 手机写回与 iPhone 迁移尚未启用；迁移请使用微信自带的聊天记录迁移功能。"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="6" BorderBrush="#E2E4E8" BorderThickness="1" Padding="16" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="第 1 步 · 连接手机" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="用数据线连接手机，确认已授权 USB 调试。点顶部【设备】按钮，看到绿色指示灯和机型即表示就绪。"/>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#5A6472"
                                   Text="指示灯是灰色时，说明 ADB 未连接、未授权，或设备不符合锁定基线（MIX 2S / Android 9 / 微信 8.0.76）。"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="6" BorderBrush="#E2E4E8" BorderThickness="1" Padding="16" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="第 2 步 · 创建只读快照" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="点顶部【快照】按钮。软件会先暂停微信以保证数据一致，再把 EnMicroMsg.db、WAL、SHM 复制到电脑，并逐个记录大小与 SHA-256。"/>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#5A6472"
                                   Text="快照保存在“文档\WXDataStudio\snapshots\时间戳”。完成后所有解析都基于这份快照，不再需要手机。要改用其它目录的快照，点【选择快照】。"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="6" BorderBrush="#E2E4E8" BorderThickness="1" Padding="16" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="第 3 步 · 解析快照" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="点顶部【解析快照】。加密库会先用快照内的受限候选自动只读打开，成功后在快照的 derived 目录生成只读明文副本，原加密库不被覆盖。"/>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#5A6472"
                                   Text="自动打开失败时，点【数据库密钥】手工输入已知文本口令或 Raw Hex；密钥只留在本次进程内存，不写入日志、快照或仓库。"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="6" BorderBrush="#E2E4E8" BorderThickness="1" Padding="16" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="第 4 步 · 选择会话" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="在左侧【会话】列表点一个联系人或群，中间列表就会显示它的消息；日志区会显示这次加载到多少条。"/>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#5A6472"
                                   Text="左上方搜索框按名称筛选会话；会话上方的搜索框可在当前会话内搜索正文、发送者、附件或消息 ID；右侧下拉框可按文字、图片媒体、卡片位置、系统消息、交易类过滤。"/>
                    </StackPanel>
                </Border>

                <Border Background="#EAF2FF" CornerRadius="6" BorderBrush="#BBD4FF" BorderThickness="1" Padding="16" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="第 5 步 · 打开工作副本（必须先做）" FontSize="16" FontWeight="SemiBold" Foreground="#123C8C"/>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#123C8C"
                                   Text="点顶部【工作副本】按钮。只有打开工作副本之后，新增和修改按钮才会亮起。"/>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#3B5BA5"
                                   Text="工作副本是电脑上的独立编辑副本，保存在“文档\WXDataStudio\workspaces”，原始快照和手机都不会被改动。"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="6" BorderBrush="#E2E4E8" BorderThickness="1" Padding="16" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="第 6 步 · 添加聊天记录" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="中间列表上方那一排就是新增入口：【+ 文字】【+ 图片】【+ 视频】【+ 语音】【+ 文件】【+ 位置/卡片】【+ 表情】【+ 名片】【+ 链接/小程序】【+ 引用】。"/>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#5A6472"
                                   Text="图片、视频、语音、表情、文件会先弹出文件选择框，选中的文件会被复制进工作副本的媒体目录；其它类型直接生成一条带模板的草稿。"/>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#5A6472"
                                   Text="新增的消息按当前时间插入并自动选中，接着在右侧“内容”页把模板文字改成你要的内容即可。"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="6" BorderBrush="#E2E4E8" BorderThickness="1" Padding="16" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="第 7 步 · 修改聊天记录" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="在中间列表选中一条消息（交易、红包、收付款类不可编辑），再在右侧【消息编辑器】里改："/>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#5A6472"
                                   Text="· 内容页：改正文 / 描述。&#10;· 日期页：改时间，改完可用【校验时间线】确认顺序。&#10;· 媒体页：【选择图片/文件】替换附件，【预览】用系统默认程序打开。&#10;· 位置/卡片、引用/小程序/名片页：改对应字段。"/>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#123C8C"
                                   Text="改完必须点底部的【保存工作副本】才会写入 JSON 文件；只改不保存，关闭后不会保留。"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="6" BorderBrush="#E2E4E8" BorderThickness="1" Padding="16" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="第 8 步 · 撤销与查看差异" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="选中消息后点【撤销】：改过的恢复成原始内容，新增的消息会被删除。"/>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="点顶部【差异】查看这个工作副本的全部改动，格式是“#消息ID 字段: 旧值 -> 新值”。"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="6" BorderBrush="#E2E4E8" BorderThickness="1" Padding="16" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="第 9 步 · 校验、报告与回滚包" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="【完整性检查】核对快照文件的大小与 SHA-256；【迁移检查】生成迁移准备报告（JSON + 文本，保存在“文档\WXDataStudio\reports”）；【回滚包】把快照打包成 ZIP 备份；【阶段三验收】执行一次只读的真机自检并写出报告。"/>
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="【导出会话】把当前会话导出一份 HTML 记录和一份 JSON 数据：HTML 可直接双击打开浏览，图片等本地附件会复制到导出目录的 assets 子目录，JSON 保留完整字段用于后续处理。导出内容包含个人聊天内容，只保存在本机，不要上传。"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="6" BorderBrush="#E2E4E8" BorderThickness="1" Padding="16" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="常见问题" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontWeight="SemiBold" Text="为什么新增/保存按钮是灰的？"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#5A6472" Text="还没打开工作副本（第 5 步）；如果列表里选中的是交易类记录，编辑器会保持只读。"/>
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontWeight="SemiBold" Text="改完了，手机微信里为什么没变化？"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#5A6472" Text="这是设计如此。修改只写进电脑上的工作副本，安卓写回尚未启用，也没有通过真机读回验证。"/>
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontWeight="SemiBold" Text="为什么有些图片、表情预览不了？"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#5A6472" Text="手机上没有缓存文件时无法定位到实物。消息本身和它的标识仍在，可正常浏览、编辑、导出。"/>
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontWeight="SemiBold" Text="编辑会不会改坏原始数据和快照？"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#5A6472" Text="不会。数据库读取走的是校验过的副本，快照在解析前后哈希一致；原始快照与手机数据库始终保持只读。"/>
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontWeight="SemiBold" Text="能删除微信里的记录吗？"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#5A6472" Text="不能。本工具不做删除，也不向手机数据库写回任何内容。"/>
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontWeight="SemiBold" Text="导出的文件会不会被别人看到？"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#5A6472" Text="导出目录和文件只在你本机上生成，软件不上传任何内容。请自行注意不要把这些文件提交到公开仓库或聊天群。"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
