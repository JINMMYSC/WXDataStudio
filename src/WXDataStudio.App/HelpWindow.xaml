<Window x:Class="WXDataStudio.App.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="使用教程 · WXDataStudio" Height="760" Width="820" MinHeight="560" MinWidth="640"
        WindowStartupLocation="CenterOwner" Background="#F5F6F7">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E4E6EA" BorderThickness="0,0,0,1" Padding="20,16">
            <StackPanel>
                <TextBlock Text="六步就能改好并同步回微信" FontSize="21" FontWeight="SemiBold"/>
                <TextBlock Margin="0,6,0,0" Foreground="#6A737D" TextWrapping="Wrap"
                           Text="照着做就行，不需要懂数据库。改错了随时可以撤销，手机上的原记录也会先备份。"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#E4E6EA" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <TextBlock VerticalAlignment="Center" Foreground="#6A737D"
                           Text="随时可以从右上角【使用教程】再次打开。"/>
                <Button Content="知道了" Width="100" Padding="0,7" HorizontalAlignment="Right" Click="OnClose"/>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
            <StackPanel>
                <Border Background="White" CornerRadius="8" BorderBrush="#E4E6EA" BorderThickness="1" Padding="18" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="第 1 步 · 把手机上的记录读到电脑" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="数据线连好手机，点右上角【读取微信记录】。软件会自动：暂停微信 → 给手机上的记录做一份只读备份 → 读出联系人和聊天。"/>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#6A737D"
                                   Text="这一步不会改动手机里的任何内容。第一次读取大概要一两分钟。"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="8" BorderBrush="#E4E6EA" BorderThickness="1" Padding="18" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="第 2 步 · 选一个聊天" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="左边是聊天列表，点一个联系人或群，中间就会像微信一样显示聊天内容：自己发的在右边绿色气泡，对方发的在左边。"/>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#6A737D"
                                   Text="上面的搜索框可以按名字或关键词找人；中间第二个搜索框能在当前聊天里搜内容。"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="8" BorderBrush="#E4E6EA" BorderThickness="1" Padding="18" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="第 3 步 · 补一条被删掉的记录" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="聊天底部有一个输入框，和微信一样：打完字点【发送】，这条记录就加进聊天里了。左边可以选这条算【我发送】还是【对方发送】。"/>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#6A737D"
                                   Text="要补图片、语音、文件、表情、位置、名片、链接，点输入框左边的【＋】选类型，再从电脑里挑文件。"/>
                    </StackPanel>
                </Border>

                <Border Background="#EAF4FF" CornerRadius="8" BorderBrush="#CFE4FF" BorderThickness="1" Padding="18" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="第 4 步 · 改一条记录" FontSize="16" FontWeight="SemiBold" Foreground="#1B5FA8"/>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#1B5FA8"
                                   Text="像在微信里一样：点中间任意一条消息，它当场变成一个输入框，直接改字，改完点【保存】；想放弃就点【取消】。"/>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#3E6EA8"
                                   Text="内容下面还有一行【时间】，按 2026-09-20 14:30 的样子填；保存后这条记录会自动按新的时间排到对应的位置。所有类型都能改，包括红包、转账、收付款记录（会标注“交易类”，改动会留痕）。想删掉某条，就在它的输入框里点【删除这条】。"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="8" BorderBrush="#E4E6EA" BorderThickness="1" Padding="18" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="第 5 步 · 改错了怎么办" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="在气泡里点【取消】就放弃这次修改；想恢复已经保存的改动，展开【更多信息】点【撤销这条修改】。新增和改过的消息上会显示“新增”“已修改”标记，一眼能看出动过哪些。"/>
                    </StackPanel>
                </Border>

                <Border Background="#E9F7EF" CornerRadius="8" BorderBrush="#B7E0C6" BorderThickness="1" Padding="18" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="第 6 步 · 同步回手机微信" FontSize="16" FontWeight="SemiBold" Foreground="#1B5E20"/>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#1B5E20"
                                   Text="确认没问题后，点右上角【写回手机】。软件会先备份手机上的原库，再把改好的记录写回去，重启微信，最后把手机上的数据库读回来核对一遍。"/>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#2E6B3A"
                                   Text="写的过程中别拔数据线。手机上会留一份 EnMicroMsg.db.wxds-backup-时间戳 的原库备份，随时能还原。"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="8" BorderBrush="#E4E6EA" BorderThickness="1" Padding="18" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="常见问题" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontWeight="SemiBold" Text="点【读取微信记录】没反应？"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#6A737D" Text="检查数据线是否插好、手机上是否允许了 USB 调试。状态栏会显示当前进行到哪一步。"/>
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontWeight="SemiBold" Text="改完手机上没变化？"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#6A737D" Text="改动先保存在电脑上，点【写回手机】并确认后才会同步，然后重新打开微信里的那个聊天就能看到。"/>
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontWeight="SemiBold" Text="图片或表情显示“附件在手机端”？"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#6A737D" Text="说明手机里没有缓存这个文件。文字内容照常显示和编辑，需要的话可以用【选择文件】从电脑上换成一张图。"/>
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontWeight="SemiBold" Text="会改坏原来的记录吗？"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#6A737D" Text="读取用的是副本，不动手机原库；写回前会先备份原库，还能用【撤销这条修改】回退。"/>
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontWeight="SemiBold" Text="改了转账/红包金额，点进去为什么提示失败？"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#6A737D" Text="聊天里显示的金额是本地文字，可以改；但转账/红包的详情页由微信服务器提供，本地改不了，点进去会提示“当前使用人数过多”之类的信息。这是正常现象，不是软件坏了。"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
